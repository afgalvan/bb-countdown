# ------------------------------------------------------------------
# Santi Jr. countdown — environment variables
# Copy this file to `.env.local` and adjust the values.
# ------------------------------------------------------------------

# The big day. ISO 8601 with an explicit offset (or Z).
NEXT_PUBLIC_BIRTH_DATE=2027-01-18T23:59:00-05:00

# Optional: displayed on the page and in metadata.
NEXT_PUBLIC_BABY_NAME=Santi Jr.

# Optional: time zone used when displaying the date.
NEXT_PUBLIC_BIRTH_TIME_ZONE=America/Bogota

# Optional: canonical URL used for Open Graph metadata.
# NEXT_PUBLIC_SITE_URL=https://santi-jr.vercel.app
